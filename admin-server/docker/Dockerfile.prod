FROM node:22-alpine AS build

WORKDIR /usr/admin-server

COPY package*.json ./
RUN npm ci

COPY ./ ./
RUN npm run build


FROM node:22-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /usr/admin-server

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /usr/admin-server/dist ./dist
# Миграции базы stats — накатываются на старте (src/visits/visits.service.ts).
COPY --from=build /usr/admin-server/drizzle ./drizzle

USER node
EXPOSE 4600

CMD ["node", "dist/main"]
