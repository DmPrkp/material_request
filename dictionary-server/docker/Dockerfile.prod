FROM node:22-alpine AS build

WORKDIR /usr/dictionary-server

COPY package*.json ./
RUN npm ci

COPY ./ ./
RUN npm run build


FROM node:22-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /usr/dictionary-server

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /usr/dictionary-server/dist ./dist
COPY --from=build /usr/dictionary-server/drizzle ./drizzle

USER node
EXPOSE 4300

# Как в dev: схема и сиды при каждом старте. Без этого прод поднимался на пустой базе —
# ни таблиц, ни справочника. Сиды повторяемые (отметки в seed_history), рестарт их не дублирует.
CMD ["sh", "-c", "node dist/db/migrate && node dist/db/seed && node dist/main"]
