FROM node:22-alpine

WORKDIR /usr/dictionary-server

COPY package*.json ./
RUN npm install

COPY ./ ./

EXPOSE 4300

# Схема — миграциями из drizzle/ (npm run db:generate по src/db/schema.ts), не push:
# тот сносил всё, чего нет в схеме, и падал на NULLS NOT DISTINCT при каждом старте.
CMD ["sh", "-c", "npm run db:migrate && npm run db:seed && npm run start:dev"]
