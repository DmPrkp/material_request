FROM nginx:1.25.3

# Домен сертификата; он же — server_name в nginx.conf и SSL_DOMAIN сервиса certbot.
ENV SSL_DOMAIN=zayavka.app

# Главный конфиг — ради модуля njs и env JWT_SECRET (см. шапку main.conf).
COPY main.conf /etc/nginx/nginx.conf
# Проверка токена: сам скрипт (без тестов) и сниппет, который его подключает в location-ах.
COPY njs/auth.js /etc/nginx/njs/auth.js
COPY snippets /etc/nginx/snippets

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Выбор сертификата и reload после продления. certbot — отдельный сервис compose.
# Неисполняемые скрипты /docker-entrypoint.sh молча пропускает.
COPY ssl/40-ssl-cert.sh /docker-entrypoint.d/40-ssl-cert.sh
RUN chmod +x /docker-entrypoint.d/40-ssl-cert.sh

EXPOSE 80
EXPOSE 443
