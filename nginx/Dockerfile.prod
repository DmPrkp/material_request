FROM nginx:1.25.3

# Установка Certbot и плагинов
RUN apt-get update && \
    apt-get install -y certbot python3-certbot-nginx python3-certbot-dns-cloudflare && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/letsencrypt/live/zayavka.app

# Главный конфиг — ради модуля njs и env JWT_SECRET (см. шапку main.conf).
COPY main.conf /etc/nginx/nginx.conf
# Проверка токена: сам скрипт (без тестов) и сниппет, который его подключает в location-ах.
COPY njs/auth.js /etc/nginx/njs/auth.js
COPY snippets /etc/nginx/snippets

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
EXPOSE 443