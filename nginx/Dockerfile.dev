FROM nginx:1.25.3

RUN rm /etc/nginx/conf.d/default.conf

# Главный конфиг — ради модуля njs и env JWT_SECRET (см. шапку main.conf).
COPY main.conf /etc/nginx/nginx.conf
# Проверка токена: сам скрипт (без тестов) и сниппет, который его подключает в location-ах.
COPY njs/auth.js /etc/nginx/njs/auth.js
COPY snippets /etc/nginx/snippets

# Голова server-блока для этой среды: http, без сертификата и HSTS. Конфиг сайта общий
# с продом — раньше dev получал его из того же файла, вырезая TLS девятью sed-шаблонами,
# и заодно терял все add_header.
COPY listen/dev.conf /etc/nginx/snippets/listen.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
