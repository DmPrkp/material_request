# Все секреты стека — в одном .env рядом с compose-файлами (сам .env в .gitignore).
# Compose подставляет их в environment сервисов: каждый получает только своё.

# Владелец всех шести баз; под ним же ходят сервисы.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Подпись токенов: знают только user-server (выпускает) и nginx (проверяет).
JWT_SECRET=

# Read-only роль админки (db/init/02-admin-readonly.sh). Пусто — роль не заводится,
# admin-server не стартует.
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=

# Необязательные — у user-server свои умолчания.
# JWT_EXPIRES_IN=3d
# DEFAULT_ADMIN_LOGIN=admin
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_FIRST_NAME=Администратор

# Почта аккаунта Let's Encrypt (сервис certbot на проде). Пусто — аккаунт без почты.
# LETSENCRYPT_EMAIL=

# Отправка писем — mail-server, релей SMTP.bz. На проде без них сервис не поднимется;
# в dev не нужны вовсе: там письма уходят в mailpit и читаются на http://localhost:8025,
# наружу ничего не улетает.
# Хост — connect.smtp.bz. Логин — почта аккаунта, пароль берётся в разделе
# «подключение и квота» панели SMTP.bz и НЕ равен API-ключу: тот только для HTTP API.
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=

# Необязательные — у mail-server свои умолчания.
# MAIL_PORT=587
# MAIL_FROM=noreply@zayavka.app
# MAIL_FROM_NAME=Заявка
# Ящика на домене нет, на noreply никто не ответит — пусть ответы идут на живой адрес.
# MAIL_REPLY_TO=
# Из него собираются ссылки в письмах: на чужой домен mail-server ссылку не пропустит.
# APP_URL=https://zayavka.app

# Каталог данных Postgres на проде (по умолчанию /mnt/tank/postgres).
# PGDATA_DIR=
