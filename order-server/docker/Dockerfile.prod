FROM node:22-alpine AS build

WORKDIR /usr/order-server

COPY package*.json ./
RUN npm ci

COPY ./ ./
RUN npm run build


FROM node:22-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /usr/order-server

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /usr/order-server/dist ./dist
COPY --from=build /usr/order-server/drizzle ./drizzle

# Сервис ничего не пишет на диск (ods собирается в памяти) — root ему не нужен.
USER node
EXPOSE 4100

CMD ["sh", "-c", "node dist/db/migrate && node dist/main"]
